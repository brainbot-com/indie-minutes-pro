# Copy to .env on aibox1. No secrets go here: tokens live in secrets/.
BIND_IP=10.1.9.7
HTTPS_PORT=8443
CA_PORT=8480
# Who may connect: the VPN client pools (they reach aibox1 unNATed; phones get
# addresses from 10.104.7.0/24, so allow the pool, not one address), ai-knowledge
# for brainbot:agent command, and the box itself for the simulator.
ALLOW_CIDRS="10.200.200.0/24 10.104.7.0/24 10.1.9.7/32 127.0.0.1/32 10.1.1.26/32"
PUBLIC_URL=https://10.1.9.7:8443
# What the apps call this box in their top bar ("aibox1 · ready").
BOX_NAME=aibox1
DISPLAY_TZ=Europe/Berlin

# Default engine for new meetings: A-iq4, A-q8, B or fake.
ENGINE=A-iq4
NEMO_URL=http://engine-nemo:8090
QWEN_URL=http://engine-qwen:8091

# LLM on aibox1's own Ollama. Keep the tag the company brain uses, so Ollama
# does not load a second copy of the model.
OLLAMA_URL=http://host.docker.internal:11434
LLM_MODEL=qwen3.8:27b-ctx65536
LLM_THINK=0

# Follow-up agent: dry-run (0) puts every proposal on /review first.
FOLLOWUP_AUTO=0
FOLLOWUP_ON_DONE=1
GITHUB_REPO=brainbot-com/indie-recorder-sandbox
# direct + the mock service: the demo runs the whole loop on the box.
# Production: FOLLOWUP_EXECUTOR=agent, then the Agent Command Center agent
# (which has GitHub and Drive access) carries out approved follow-ups.
FOLLOWUP_EXECUTOR=direct
GITHUB_API_URL=http://mock:8099/github
DRIVE_API_URL=http://mock:8099/drive
DRIVE_LOG_DOC="Meeting log"
DRIVE_FOLDER="indie-recorder test"
# drive (default), or drive,github for GitHub issue proposals as well.
FOLLOWUP_TARGETS=drive
# Where new recordings go until someone changes the setting: local or drive.
STORAGE_DEFAULT=local
# Where agents download a Drive meeting's files (signed links, two hours).
# For brainbot:agent command: https://ai-knowledge.mz.brainbot.com/indie-recorder/api/v1/files
FILES_BASE_URL=https://10.1.9.7:8443/api/v1/files
# Meetings created before this day are not offered to the agent for a new summary.
#AGENT_SUMMARIES_SINCE=2026-11-18
