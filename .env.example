# Copy to .env on the server (the compose.yaml next to it). No secrets go here:
# tokens and keys live in secrets/. The addresses below are examples.
BIND_IP=192.168.1.20
HTTPS_PORT=8443
CA_PORT=8480
# Who may connect: your VPN's client pools (phones on the VPN get addresses from
# a pool, so allow the pool, not one address), a proxy in front of the recorder
# if there is one, and the server itself for the simulator.
ALLOW_CIDRS="10.8.0.0/24 192.168.1.20/32 127.0.0.1/32"
PUBLIC_URL=https://192.168.1.20:8443
# What the apps call this box in their top bar ("Box · ready").
BOX_NAME=Box
# Where a phone's connect code leads: the connect page, best behind a proxy with a
# certificate phones trust (brainbot:agent command, for example). Default: this box.
#CONNECT_URL=https://agent.example.com/indie-recorder/connect
#APK_URL=https://agent.example.com/indie-recorder/indie-recorder.apk
#WEBAPP_URL=https://192.168.1.20:8443/app/
DISPLAY_TZ=Europe/Berlin

# Default engine for new meetings: A-iq4, A-q8, B or fake.
ENGINE=A-iq4
NEMO_URL=http://engine-nemo:8090
QWEN_URL=http://engine-qwen:8091

# The model for the minutes, on the server's own Ollama. If other services use
# the same model, keep their tag, so Ollama does not load a second copy.
OLLAMA_URL=http://host.docker.internal:11434
LLM_MODEL=qwen3.8:27b-ctx65536
LLM_THINK=0

# Follow-up agent: dry-run (0) puts every proposal on /review first.
FOLLOWUP_AUTO=0
FOLLOWUP_ON_DONE=1
GITHUB_REPO=your-org/your-repo
# direct + the mock service: the demo runs the whole loop on the box.
# Production: FOLLOWUP_EXECUTOR=agent, then the Agent Command Center agent
# (which has GitHub and Drive access) carries out approved follow-ups.
FOLLOWUP_EXECUTOR=direct
GITHUB_API_URL=http://mock:8099/github
DRIVE_API_URL=http://mock:8099/drive
DRIVE_LOG_DOC="Meeting log"
DRIVE_FOLDER="Minutes Pro"
# drive (default), or drive,github for GitHub issue proposals as well.
FOLLOWUP_TARGETS=drive
# Where new recordings go until someone changes the setting: local or drive.
STORAGE_DEFAULT=local
# Where agents download a Drive meeting's files (signed links, two hours).
# Behind brainbot:agent command: https://agent.example.com/indie-recorder/api/v1/files
FILES_BASE_URL=https://192.168.1.20:8443/api/v1/files
# Meetings created before this day are not offered to the agent for a new summary.
#AGENT_SUMMARIES_SINCE=2026-11-18
