# Copy to .env and fill in the two values below (standalone/README.md).

# Signs you in to the recorder in a browser.
RECORDER_PASSWORD=
# Encrypts every recording, transcript and summary: 32 random bytes, base64url.
#   openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
# Keep a copy somewhere safe: without it the meetings cannot be read.
RECORDER_DATA_KEY=
# Shown on your phones (optional).
RECORDER_OWNER=
# What the apps call this computer.
RECORDER_BOX_NAME=this computer

# Linux with an AMD or Intel GPU: run the speech engine here too.
COMPOSE_PROFILES=engine
# Without a usable GPU: cpu (slow, about half real time).
#NEMO_DEVICE=cpu

# A Mac: the engine runs natively (mac/engine.sh), and both share this folder.
#COMPOSE_PROFILES=
#NEMO_URL=http://host.docker.internal:8090
#SCRATCH=./scratch

# Summaries: an Ollama on this computer (or another one you own).
OLLAMA_URL=http://host.docker.internal:11434
LLM_MODEL=qwen3:14b
LLM_CONTEXT=32768

# Ports
HTTPS_PORT=8443
CA_PORT=8480
