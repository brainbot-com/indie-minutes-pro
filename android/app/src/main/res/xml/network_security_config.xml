<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only. A box that hands its CA over when the phone connects is pinned to it
     (Box.kt); one that does not (an Indie Box with a public certificate, or with its own
     certificate authority, which people install on the phone in Android's settings) is
     checked against the system's and the user's certificate authorities. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
